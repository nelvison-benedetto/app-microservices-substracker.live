# Dominio / TLS
API_DOMAIN=api.substracker.live
ACME_EMAIL=you@example.com

# JWT 
JWT_ISSUER=https://api.substracker.live
JWT_AUDIENCE=subsnap-api

# PostgreSQL
POSTGRES_PASSWORD=change_me_root
IDENTITY_DB_PASSWORD=change_me_identity
SUBSCRIPTIONS_DB_PASSWORD=change_me_subscriptions
MEDIA_DB_PASSWORD=change_me_media

# MongoDB
MONGO_ROOT_USER=subsnap
MONGO_ROOT_PASSWORD=change_me_mongo

# Redis 
REDIS_PASSWORD=change_me_redis

# RabbitMQ 
RABBITMQ_USER=subsnap
RABBITMQ_PASSWORD=change_me_rabbit

# Neo4j (min 8 caratteri)
NEO4J_PASSWORD=change_me_neo4j

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=subsnap-media

# SMTP (in sviluppo: Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SubSnap <no-reply@substracker.live>

# Observability
TRACE_SAMPLING_RATIO=0.1