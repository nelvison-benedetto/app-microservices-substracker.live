{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  // I file non passano da qui (upload diretto su R2): body piccolo
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 16384
    }
  },

  // Password da variabile d'ambiente ConnectionStrings__MediaDb
  "ConnectionStrings": {
    "MediaDb": "Host=postgres;Port=5432;Database=media_db;Username=media_svc"
  },

  "Auth": {
    "MetadataAddress": "http://identity:8080/.well-known/openid-configuration",
    "Issuer": "subsnapms-identity",
    "Audience": "subsnapms-api",
    "ClockSkewSeconds": 30
  },

  "Services": {
    "Identity": { "GrpcAddress": "http://identity:8081" }
  },

  // Chiavi da variabili d'ambiente: Storage__AccountId, Storage__AccessKeyId, Storage__SecretAccessKey
  "Storage": {
    "BucketName": "assets",
    "PublicBaseUrl": "https://cdn.substracker.live",
    "ForcePathStyle": false
  },

  "Media": {
    "Uploads": {
      "UploadUrlLifetime": "00:05:00",
      "PendingCleanupAfter": "01:00:00",
      "CleanupInterval": "01:00:00"
    }
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "MediatR": { "LicenseKey": "" },

  "Database": { "MigrateOnStartup": false },

  "Sentry": { "Dsn": "" }
}