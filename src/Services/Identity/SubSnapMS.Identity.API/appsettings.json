{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 8080: REST + JWKS + health (HTTP/1.1). 8081: gRPC (HTTP/2 senza TLS). Nessuna delle due è pubblicata.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 65536
    }
  },

  // Password dalla variabile d'ambiente ConnectionStrings__IdentityDb
  "ConnectionStrings": {
    "IdentityDb": "Host=postgres;Port=5432;Database=identity_db;Username=identity_svc"
  },

  // MetadataAddress vuoto: Identity valida i token con le proprie chiavi
  "Auth": {
    "MetadataAddress": "",
    "Issuer": "subsnapms-identity",
    "Audience": "subsnapms-api",
    "ClockSkewSeconds": 30
  },

  "Identity": {
    // Chiavi RSA private: da secret/variabili d'ambiente (es. Identity__Jwt__SigningKeys__0__PrivateKeyPem)
    "Jwt": {
      "AccessTokenLifetime": "00:10:00",
      "SigningKeys": []
    },
    "Sessions": {
      "RefreshTokenLifetime": "30.00:00:00",
      "ReuseGracePeriod": "00:00:30"
    },
    "UserDeletion": {
      "ExpectedServices": [ "subscriptions", "media" ]
    }
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "MediatR": { "LicenseKey": "" },

  "Database": { "MigrateOnStartup": false },

  "Sentry": { "Dsn": "" }
}