{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Neo4j": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Solo GET: nessun body
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    },
    "Limits": { "MaxRequestBodySize": 1024 }
  },

  // Password da variabile d'ambiente Neo4j__Password
  "Neo4j": {
    "Uri": "bolt://neo4j:7687",
    "Username": "neo4j",
    "Database": "neo4j",
    "MaxConnectionPoolSize": 50
  },

  "Auth": {
    "MetadataAddress": "http://identity:8080/.well-known/openid-configuration",
    "Issuer": "subsnapms-identity",
    "Audience": "subsnapms-api",
    "ClockSkewSeconds": 30
  },

  "Graph": {
    "TimeZone": "Europe/Rome",
    "MinUsersForRecommendation": 3,
    "DeletedTombstoneRetention": "30.00:00:00",
    "CleanupInterval": "1.00:00:00"
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "Sentry": { "Dsn": "" }
}