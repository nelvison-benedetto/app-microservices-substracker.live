{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 65536
    }
  },

  // Password da variabili d'ambiente: ConnectionStrings__SubscriptionsDb, ConnectionStrings__Redis
  "ConnectionStrings": {
    "SubscriptionsDb": "Host=postgres;Port=5432;Database=subscriptions_db;Username=subscriptions_svc",
    "Redis": "redis:6379"
  },

  // Chiavi pubbliche scaricate da Identity sulla rete interna
  "Auth": {
    "MetadataAddress": "http://identity:8080/.well-known/openid-configuration",
    "Issuer": "subsnapms-identity",
    "Audience": "subsnapms-api",
    "ClockSkewSeconds": 30
  },

  "Subscriptions": {
    "Caching": {
      "UserSubscriptionsExpiration": "00:10:00",
      "LocalCacheExpiration": "00:01:00"
    }
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "MediatR": { "LicenseKey": "" },

  "Database": { "MigrateOnStartup": false },

  "Sentry": { "Dsn": "" }
}