{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5107",
        "Protocols": "Http1"
      }
    }
  },

  "ConnectionStrings": {
    "NotificationDb": "mongodb://notification_svc:notification_dev@localhost:27017/notification_db?authSource=notification_db"
  },

  // Mailpit: cattura tutte le email, le vedi su http://localhost:8025
  "Email": {
    "AppBaseUrl": "http://localhost:3000",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  },

  // In sviluppo: promemoria a qualsiasi ora, controllo ogni minuto
  "Notification": {
    "Reminders": {
      "SendFromHour": 0,
      "SendUntilHour": 24,
      "CheckInterval": "00:01:00"
    }
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "localhost",
      "Username": "subsnap",
      "Password": "subsnap"
    }
  }
}