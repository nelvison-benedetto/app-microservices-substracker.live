{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Solo health check sulla rete interna
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    },
    "Limits": { "MaxRequestBodySize": 1024 }
  },

  // In produzione l'intera stringa (con password) da ConnectionStrings__NotificationDb
  "ConnectionStrings": {
    "NotificationDb": "mongodb://mongo:27017/notification_db"
  },

  // Credenziali da Email__Smtp__Username / Email__Smtp__Password
  "Email": {
    "FromAddress": "noreply@substracker.live",
    "FromName": "SubSnap",
    "AppBaseUrl": "https://substracker.live",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "Timeout": "00:00:30"
    }
  },

  "Notification": {
    "Welcome": {
      "Enabled": true,
      "MaxEventAge": "2.00:00:00"
    },
    "Reminders": {
      "Enabled": true,
      "DaysBefore": 3,
      "TimeZone": "Europe/Rome",
      "SendFromHour": 8,
      "SendUntilHour": 21,
      "CheckInterval": "00:30:00",
      "BatchSize": 500
    },
    "Delivery": {
      "MaxAttempts": 5,
      "ClaimLease": "00:05:00",
      "LogRetention": "180.00:00:00"
    },
    "DeletedTombstoneRetention": "30.00:00:00"
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "Sentry": { "Dsn": "" }
}