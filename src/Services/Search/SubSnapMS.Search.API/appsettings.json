{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Solo GET: nessun body
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    },
    "Limits": { "MaxRequestBodySize": 1024 }
  },

  // Credenziali da variabili d'ambiente: Elasticsearch__ApiKey (o Elasticsearch__Username / __Password)
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200",
    "NumberOfReplicas": 0
  },

  "Auth": {
    "MetadataAddress": "http://identity:8080/.well-known/openid-configuration",
    "Issuer": "subsnapms-identity",
    "Audience": "subsnapms-api",
    "ClockSkewSeconds": 30
  },

  "Search": {
    "TimeZone": "Europe/Rome",
    "DeletedTombstoneRetention": "30.00:00:00",
    "CleanupInterval": "1.00:00:00"
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "Sentry": { "Dsn": "" }
}