{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Solo GET: nessun body
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    },
    "Limits": { "MaxRequestBodySize": 1024 }
  },

  // In produzione l'intera stringa (con password) da ConnectionStrings__AnalyticsDb
  "ConnectionStrings": {
    "AnalyticsDb": "mongodb://mongo:27017/analytics_db"
  },

  "Auth": {
    "MetadataAddress": "http://identity:8080/.well-known/openid-configuration",
    "Issuer": "subsnapms-identity",
    "Audience": "subsnapms-api",
    "ClockSkewSeconds": 30
  },

  "Analytics": {
    "TimeZone": "Europe/Rome",
    "DeletedTombstoneRetention": "30.00:00:00"
  },

  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Username": "subsnap"
    }
  },

  "Sentry": { "Dsn": "" }
}