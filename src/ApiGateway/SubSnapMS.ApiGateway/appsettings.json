{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning", //abbassa il rumore di log interni di apsnetcore
      "Yarp": "Information" //x ogni req inoltrata vedi e.g. Proxying to http://subsnap-api:8080/api/v1/...” + risultato.
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  },
  "Sentry": {
    "Dsn": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },


  "ReverseProxy": {
    "Routes": { //quale req in ingresso va su quale cluster
      // Route specifiche con rate limit stretto: vincono sui catch-all di identity
      "identity-login": {
        "ClusterId": "identity", //a quale cluster send le req che matchano, ovviamente il cluster deve esistere here qu sotto in 'Clusters'
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [ "POST" ]
        } //oltre a Match potresti anche aggiungere Methods(e.g. solo GET)/Hosts/Headers/QueryParameters ect
      },
      "identity-register": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/users/register",
          "Methods": [ "POST" ]
        }
      },
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "subscriptions": {
        "ClusterId": "subscriptions",
        "Match": { "Path": "/api/v1/subscriptions/{**catch-all}" }
      },
      "media": {
        "ClusterId": "media",
        "Match": { "Path": "/api/v1/media/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/v1/analytics/{**catch-all}" }
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/v1/search/{**catch-all}" }
      },
      "recommendations": {
        "ClusterId": "graph",
        "Match": { "Path": "/api/v1/recommendations/{**catch-all}" }
      }
    },

    "Clusters": { //dove si trova il target destination, un cluster puo avere piu destination (e yarp bilancia il carico)
      "identity": { "Destinations": { "d1": { "Address": "http://identity:8080/" } } },
      "subscriptions": { "Destinations": { "d1": { "Address": "http://subscriptions:8080/" } } },
      "media": { "Destinations": { "d1": { "Address": "http://media:8080/" } } },
      "analytics": { "Destinations": { "d1": { "Address": "http://analytics:8080/" } } },
      "search": { "Destinations": { "d1": { "Address": "http://search:8080/" } } },
      "graph": { "Destinations": { "d1": { "Address": "http://graph:8080/" } } }
    }

  }
}
