{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning", //abbassa il rumore di log interni di apsnetcore
      "Yarp": "Information" //x ogni req inoltrata vedi e.g. Proxying to http://subsnap-api:8080/api/v1/...” + risultato.
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  },
  "Sentry": {
    "Dsn": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },


  "ReverseProxy": {
    "Routes": { //quale req in ingresso va su quale cluster
      "monolith-login": { //è il routeId
        "ClusterId": "monolith", //a quale cluster send le req che matchano, ovviamente il cluster deve esistere here qu sotto in 'Clusters'
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [ "POST" ]
        } //oltre a Match potresti anche aggiungere Methods(e.g. solo GET)/Hosts/Headers/QueryParameters ect
      },
      "monolith-register": {
        "ClusterId": "monolith",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/users/register",
          "Methods": [ "POST" ]
        }
      },
      "monolith-api": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": { //dove si trova il target destination, un cluster puo avere piu destination (e yarp bilancia il carico)
      "monolith": { //clusterId
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },

        "Destinations": { //le istanze del servizio
          "primary": { "Address": "http://subsnap-api:8080/" }
        }
        //se avessi 3 repliche scriveresti e.g. "d1", "d2", "d3", ognuna con il proprio Address, e YARP bilancerebbe tra loro
      }
    }
  }
}
